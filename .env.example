# ==============================================================================
# MakerPixel Gestão API — Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e preencha com as suas configurações locais
# ==============================================================================

# Porta do Servidor
PORT=8080

# Banco de Dados PostgreSQL
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/makerpixel_contabil
SPRING_DATASOURCE_USERNAME=makerpixel
SPRING_DATASOURCE_PASSWORD=makerpixel_secret_example_only

# Segurança JWT (chave HMAC SHA-256 de pelo menos 256 bits)
JWT_SECRET=coloque-aqui-uma-chave-jwt-segura-com-no-minimo-256-bits-makerpixel

# Integração BrasilAPI
BRASIL_API_URL=https://brasilapi.com.br/api/cnpj/v1
